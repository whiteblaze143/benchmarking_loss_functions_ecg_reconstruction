def interaction_means(data, outcome):
    """
    Display observed mean outcomes for all derivative × VCG
    combinations.
    """

    required = [
        outcome,
        "deriv_on",
        "vcg_on",
    ]

    if not all(
        column in data.columns
        for column in required
    ):
        return None

    result = (
        data
        .groupby(["deriv_on", "vcg_on"])[outcome]
        .agg(["mean", "std", "count"])
        .reset_index()
    )

    result["deriv_label"] = result["deriv_on"].map({
        0: "Derivative off",
        1: "Derivative on",
    })

    result["vcg_label"] = result["vcg_on"].map({
        0: "VCG off",
        1: "VCG on",
    })

    return result


