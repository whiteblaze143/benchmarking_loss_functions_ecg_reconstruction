\title{\Large\textbf{Quality-Aware Multimodal SetOperator for Continuous Post-Ablation Atrial Fibrillation Recurrence Ascertainment Under Imperfect Wearable Monitoring}}

\author{
  \textbf{Mithun Manivannan}$^{1,2}$, \textbf{Alex Mariakakis}$^{2}$, \textbf{Christopher Cheung}$^{1,3,*}$ \\[0.5em]
