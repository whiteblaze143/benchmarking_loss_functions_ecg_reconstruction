# Human-readable mask description
def describe_mask(row):
    active_components = []

    if row["mse_on"] == 1:
        active_components.append("MSE")
    if row["corr_on"] == 1:
        active_components.append("Correlation")
    if row["deriv_on"] == 1:
        active_components.append("Derivative")
    if row["vcg_on"] == 1:
        active_components.append("VCG")
    if row["energy_on"] == 1:
        active_components.append("Energy distance")
    if row["lead_on"] == 1:
        active_components.append("Lead consistency")
    if row["mmd_kernel"] > 0:
        active_components.append(
            f"MMD: {row['mmd_name']}"
        )

    return " + ".join(active_components)


