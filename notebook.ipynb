# ============================================================
# Cell 2 — Load the clinical metrics data
# ============================================================

def load_metrics_data(db_path=DB_PATH, csv_path=CSV_PATH):
    """
    Load clinical metrics from SQLite.

    If SQLite is unavailable or empty, fall back to the CSV file.
    """

    # Attempt SQLite loading
    if db_path.exists():
        try:
            with sqlite3.connect(db_path) as conn:
                tables = pd.read_sql_query(
                    """
                    SELECT name
                    FROM sqlite_master
                    WHERE type='table'
                    """,
                    conn
                )

                print("SQLite tables found:")
                display(tables)

                if "clinical_metrics" in tables["name"].tolist():
                    data = pd.read_sql_query(
                        "SELECT * FROM clinical_metrics",
                        conn
                    )

                    if len(data) > 0:
                        print(
                            f"Loaded {len(data):,} rows from SQLite."
                        )
                        return data

                    print(
                        "SQLite table exists but is empty. "
                        "Trying CSV fallback."
                    )

        except Exception as error:
            print(f"SQLite loading failed: {error}")

    # Attempt CSV loading
    if csv_path.exists():
        data = pd.read_csv(csv_path)
        print(
            f"Loaded {len(data):,} rows from CSV fallback."
        )
        return data

    raise FileNotFoundError(
        "Neither the SQLite database nor the CSV file was found."
    )


df = load_metrics_data()

print("\nDataset dimensions:")
print(df.shape)

print("\nColumns:")
print(df.columns.tolist())

display(df.head())
