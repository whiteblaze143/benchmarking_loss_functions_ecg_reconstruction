# ============================================================
# Cell 7 — Per-mask performance summaries
# ============================================================

def summarize_by_mask(data, metrics=None):
    """
    Calculate performance summaries by factorial mask.
    """

    if metrics is None:
        metrics = [
            column
            for column in [
                "mae",
                "pearson_r",
                "r2",
                "auroc",
                "auprc",
                "f1",
            ]
            if column in data.columns
        ]

    grouping_columns = [
        "model_id",
        "mask",
        "mask_description",
        "mmd_name",
    ]

    grouping_columns = [
        column
        for column in grouping_columns
        if column in data.columns
    ]

    summary = (
        data.groupby(grouping_columns)[metrics]
        .mean()
        .reset_index()
    )

    counts = (
        data.groupby(grouping_columns)["target"]
        .nunique()
        .reset_index(name="n_targets")
    )

    summary = summary.merge(
        counts,
        on=grouping_columns,
        how="left"
    )

    return summary


signal_mask_summary = summarize_by_mask(signal_df)
biomarker_mask_summary = summarize_by_mask(biomarker_df)

print("Signal reconstruction summary:")
display(signal_mask_summary.head())

print("Biomarker summary:")
display(biomarker_mask_summary.head())
