\label{tab:episodes}
\begin{tabular}{lcc}
\toprule
\textbf{Model Architecture} & \textbf{$\ge$ 30s Episodes (N=166)} & \textbf{$\ge$ 6min Episodes (N=62)} \\
\midrule
ArNet2 (Biton et al., 2023) & 92.8\% (154/166) & 100.0\% (62/62) \\
RawECGNet (1D-CNN) & 0.0\% (0/166) & 0.0\% (0/62) \\
Phase-KME Alone & 0.0\% (0/166) & 0.0\% (0/62) \\
SetOperator + RR (Multimodal) & \textbf{98.8\%} (164/166) & \textbf{100.0\%} (62/62) \\
Quality-Aware SetOperator ($M_5$) & \textbf{97.6\%} (162/166) & \textbf{100.0\%} (62/62) \\
\bottomrule
\end{tabular}
\end{table}

