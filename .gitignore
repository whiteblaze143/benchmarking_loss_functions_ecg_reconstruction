# Databases are authoritative on-disk experiment artifacts, never Git content.
*.sqlite
*.sqlite-*
*.db
*.db-*

# TEMPORARY: live SQLite files mutate during LUDB evaluation. Remove these
# entries and re-add the final stable databases through Git LFS after the run.
results/ecgaim_ludb_oracle/ecgaim_ludb_oracle.sqlite
results/ecgaim_ludb_oracle/ecgaim_ludb_oracle.sqlite-shm
results/ecgaim_ludb_oracle/ecgaim_ludb_oracle.sqlite-wal
# TEMPORARY: RDB production outputs will mutate for several days. Remove these
# entries only after the daemon is stopped and the final exports are stable.
results/ecgaim_rdb_oracle/*.sqlite
results/ecgaim_rdb_oracle/*.sqlite-shm
results/ecgaim_rdb_oracle/*.sqlite-wal
results/ecgaim_rdb_oracle/*.csv
results/checkpoint_store/catalog.sqlite
results/checkpoint_store/catalog.sqlite-shm
results/checkpoint_store/catalog.sqlite-wal
