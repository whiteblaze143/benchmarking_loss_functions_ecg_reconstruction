# ============================================================
# Cell 18 — Compare masks using clustered bootstrap
# ============================================================

def bootstrap_mask_difference(
    data,
    mask_a,
    mask_b,
    outcome,
    cluster_column="model_id",
    n_boot=2000,
    random_seed=42,
):
    """
    Estimate the difference between two masks.

    Difference is calculated as:

        mean(mask B) - mean(mask A)

    For MAE:
        negative values favor mask B.

    For Pearson, R2, AUROC:
        positive values favor mask B.
    """

    subset = data[
        data["mask"].isin([mask_a, mask_b])
    ].dropna(
        subset=[
            "mask",
            cluster_column,
            outcome,
        ]
    ).copy()

    mask_a_data = subset[
        subset["mask"] == mask_a
    ]

    mask_b_data = subset[
        subset["mask"] == mask_b
    ]

    common_clusters = sorted(
        set(mask_a_data[cluster_column])
        & set(mask_b_data[cluster_column])
    )

    if len(common_clusters) == 0:
        raise ValueError(
            "No common clusters between the masks."
        )

    mask_a_data = mask_a_data[
        mask_a_data[cluster_column].isin(common_clusters)
    ]

    mask_b_data = mask_b_data[
        mask_b_data[cluster_column].isin(common_clusters)
    ]

    observed_difference = (
        mask_b_data[outcome].mean()
        - mask_a_data[outcome].mean()
    )

    rng = np.random.default_rng(random_seed)
    bootstrap_differences = []

    for _ in range(n_boot):
        sampled_clusters = rng.choice(
            common_clusters,
            size=len(common_clusters),
            replace=True,
        )

        a_values = []
        b_values = []

        for cluster in sampled_clusters:
            a_values.extend(
                mask_a_data.loc[
                    mask_a_data[cluster_column] == cluster,
                    outcome,
                ].tolist()
            )

            b_values.extend(
                mask_b_data.loc[
                    mask_b_data[cluster_column] == cluster,
                    outcome,
                ].tolist()
            )

        if len(a_values) > 0 and len(b_values) > 0:
            bootstrap_differences.append(
                np.mean(b_values) - np.mean(a_values)
            )

    bootstrap_differences = np.asarray(
        bootstrap_differences
    )

    return {
        "mask_a": mask_a,
        "mask_b": mask_b,
        "outcome": outcome,
        "estimate_b_minus_a": observed_difference,
        "ci_lower": np.percentile(
            bootstrap_differences,
            2.5
        ),
        "ci_upper": np.percentile(
            bootstrap_differences,
            97.5
        ),
        "n_common_clusters": len(common_clusters),
    }


baseline_mask = "1000000"

candidate_masks = [
    "1100000",
    "1010000",
    "1001000",
    "1011000",
    "1110000",
]

difference_results = []

for candidate_mask in candidate_masks:
    for outcome in ["mae", "pearson_r", "r2", "auroc"]:
        if outcome not in df.columns:
            continue

        try:
            result = bootstrap_mask_difference(
                data=df,
                mask_a=baseline_mask,
                mask_b=candidate_mask,
                outcome=outcome,
                cluster_column="model_id",
                n_boot=N_BOOTSTRAP,
                random_seed=RANDOM_SEED,
            )

            difference_results.append(result)

        except Exception as error:
            print(
                f"Could not compare {candidate_mask} "
                f"for {outcome}: {error}"
            )

difference_results_df = pd.DataFrame(
    difference_results
)

display(
    difference_results_df.round(4)
)
