```python
# ============================================================
# Cell 19 — Create a final interpretation table
# ============================================================

def interpret_difference(row):
    """
    Interpret candidate-minus-baseline differences.
    """

    outcome = row["outcome"]
    estimate = row["estimate_b_minus_a"]
    lower = row["ci_lower"]
    upper = row["ci_upper"]

    interval_excludes_zero = (
        lower > 0
        or upper < 0
    )

    if outcome == "mae":
        direction = (
            "Candidate improves MAE"
            if estimate < 0
            else "Candidate worsens MAE"
        )
    else:
        direction = (
            "Candidate improves metric"
            if estimate > 0
            else "Candidate worsens metric"
        )

    if not interval_excludes_zero:
        direction += "; CI includes no difference"

    return direction


if len(difference_results_df) > 0:
    difference_results_df["interpretation"] = (
        difference_results_df.apply(
            interpret_difference,
            axis=1
        )
    )

    display(
        difference_results_df[
            [
                "mask_a",
                "mask_b",
                "outcome",
                "estimate_b_minus_a",
                "ci_lower",
                "ci_upper",
                "interpretation",
            ]
        ].round(4)
    )
