```python
# ============================================================
# Cell 16 — BCa confidence interval
# ============================================================

def bca_confidence_interval(
    data,
    cluster_column,
    outcome_column,
    stat_fn=np.mean,
    n_boot=2000,
    alpha=0.05,
    random_seed=42,
):
    """
    Bias-corrected and accelerated (BCa) confidence interval.

    The resampling unit is the cluster, not the individual row.
    """

    clean_data = data.dropna(
        subset=[cluster_column, outcome_column]
    ).copy()

    clusters = clean_data[cluster_column].unique()
    n_clusters = len(clusters)

    if n_clusters < 5:
        raise ValueError(
            "At least five clusters are recommended for BCa."
        )

    observed_value, bootstrap_values = (
        cluster_bootstrap_statistic(
            data=clean_data,
            cluster_column=cluster_column,
            outcome_column=outcome_column,
            stat_fn=stat_fn,
            n_boot=n_boot,
            random_seed=random_seed,
        )
    )

    # Bias-correction factor
    proportion_below = np.mean(
        bootstrap_values < observed_value
    )

    # Avoid infinite normal quantiles
    proportion_below = np.clip(
        proportion_below,
        1 / (2 * n_boot),
        1 - 1 / (2 * n_boot),
    )

    z0 = stats.norm.ppf(proportion_below)

    # Jackknife estimates, leaving out one cluster at a time
    jackknife_values = []

    for cluster_to_remove in clusters:
        jackknife_data = clean_data[
            clean_data[cluster_column] != cluster_to_remove
        ]

        jackknife_values.append(
            stat_fn(
                jackknife_data[outcome_column].to_numpy()
            )
        )

    jackknife_values = np.asarray(jackknife_values)
    jackknife_mean = jackknife_values.mean()

    numerator = np.sum(
        (jackknife_mean - jackknife_values) ** 3
    )

    denominator = 6.0 * (
        np.sum(
            (jackknife_mean - jackknife_values) ** 2
        ) ** 1.5
    )

    acceleration = (
        numerator / denominator
        if denominator != 0
        else 0.0
    )

    z_alpha_low = stats.norm.ppf(alpha / 2)
    z_alpha_high = stats.norm.ppf(1 - alpha / 2)

    adjusted_low = stats.norm.cdf(
        z0
        + (
            z0 + z_alpha_low
        ) / (
            1
            - acceleration * (
                z0 + z_alpha_low
            )
        )
    )

    adjusted_high = stats.norm.cdf(
        z0
        + (
            z0 + z_alpha_high
        ) / (
            1
            - acceleration * (
                z0 + z_alpha_high
            )
        )
    )

    lower_bound = np.quantile(
        bootstrap_values,
        adjusted_low
    )

    upper_bound = np.quantile(
        bootstrap_values,
        adjusted_high
    )

    return {
        "estimate": observed_value,
        "ci_lower": lower_bound,
        "ci_upper": upper_bound,
        "bias_correction_z0": z0,
        "acceleration": acceleration,
        "n_clusters": n_clusters,
        "n_bootstrap": n_boot,
    }
