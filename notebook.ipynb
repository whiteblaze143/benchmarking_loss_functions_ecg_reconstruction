# ============================================================
# Cell 8 — Rank masks for different objectives
# ============================================================

def display_best_masks(
    summary,
    title,
    metric_directions=None,
    n=10,
):
    """
    Display best masks using different metrics.

    For MAE, lower is better.
    For correlation, R2, AUROC, and AUPRC, higher is better.
    """

    print(f"\n{title}")

    if metric_directions is None:
        metric_directions = {
            "mean_mae": True,
            "mean_pearson": False,
            "mean_r2": False,
            "mean_auroc": False,
            "mean_auprc": False,
        }

    for metric, ascending in metric_directions.items():
        if metric not in summary.columns:
            continue

        print(f"\nBest masks by {metric}:")

        columns = [
            "model_id",
            "mask",
            "mask_description",
            metric,
            "n_targets",
        ]

        columns = [
            column
            for column in columns
            if column in summary.columns
        ]

        display(
            summary
            .sort_values(metric, ascending=ascending)
            [columns]
            .head(n)
            .round(4)
        )


display_best_masks(
    signal_mask_summary,
    "Signal Reconstruction Mask Rankings"
)

display_best_masks(
    biomarker_mask_summary,
    "Biomarker Mask Rankings"
)
