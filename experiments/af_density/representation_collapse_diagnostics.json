  "mechanistic_root_cause_reconstruction": {
    "core_mechanisms": [
      {
        "name": "Discrete Token Symmetry Collapse",
        "description": "Discrete categorical IDs {0, 1} or constant zero vector in q_ablated provide no spatial or geometric coordinate grounding. When |S| = 1 (single lead valid), self-attention degenerates into an unconstrained feedforward layer. LayerNorm and residual connection damping contract the output toward a fixed-point invariant subspace."
      },
      {
        "name": "Loss Surface Flatness & Marginal Prior Attraction",
        "description": "Under weighted binary cross-entropy with 23.7% positive prevalence, predicting a constant logit log(0.2373 / (1 - 0.2373)) = -1.167 achieves BCE = 0.54795. Without token-level contrastive or reconstruction gradients, the set encoder discovers that suppressing all PhaseCNN variation (SD 10.32 -> 3.45e-6) provides an immediate local optimum, trapping gradient descent."
      },
      {
        "name": "Decoupled Representation Learning vs Pure Discriminative Objective",
        "description": "In the absence of an auxiliary reconstruction decoder or geometric alignment loss, the Transformer set encoder acts as an information bottleneck that discards all morphological variation not linearly separable in the initial random projection."
      }
    ],
    "architectural_cure": {
      "solution": "Continuous SetOperator with Continuous Lead Operator Embeddings (EchoNext)",
      "mechanism": "Continuous operator projections q in R^8 directly map nominal Einthoven lead vectors into continuous geometric coordinates. This breaks discrete token symmetry, conditions self-attention on physical lead geometry, and prevents contractive collapse across windows and channels."
    }
  }
