# ============================================================
# Cell 15 — Cluster bootstrap utilities
# ============================================================

def cluster_bootstrap_statistic(
    data,
    cluster_column,
    outcome_column,
    stat_fn=np.mean,
    n_boot=2000,
    random_seed=42,
):
    """
    Cluster bootstrap.

    Entire clusters are sampled with replacement.
    This is preferable to resampling individual rows when
    multiple rows come from the same model or patient.
    """

    rng = np.random.default_rng(random_seed)

    clean_data = data.dropna(
        subset=[cluster_column, outcome_column]
    ).copy()

    clusters = clean_data[cluster_column].unique()
    n_clusters = len(clusters)

    if n_clusters < 2:
        raise ValueError(
            "At least two clusters are required."
        )

    observed_value = stat_fn(
        clean_data[outcome_column].to_numpy()
    )

    bootstrap_values = np.empty(n_boot)

    for iteration in range(n_boot):
        sampled_clusters = rng.choice(
            clusters,
            size=n_clusters,
            replace=True,
        )

        sampled_parts = [
            clean_data[
                clean_data[cluster_column] == cluster
            ]
            for cluster in sampled_clusters
        ]

        bootstrap_sample = pd.concat(
            sampled_parts,
            ignore_index=True
        )

        bootstrap_values[iteration] = stat_fn(
            bootstrap_sample[outcome_column].to_numpy()
        )

    return observed_value, bootstrap_values
