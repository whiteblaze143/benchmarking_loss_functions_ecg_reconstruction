        outcome,
        group_column,
        "mse_on",
        "corr_on",
        "deriv_on",
        "vcg_on",
    ]

    missing_columns = [
        column
        for column in required_columns
        if column not in data.columns
    ]

    if missing_columns:
        print(
            f"GEE cannot run; missing {missing_columns}"
        )
        return None

